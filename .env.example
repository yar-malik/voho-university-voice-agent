# ---------------------------------------------------------------- Voho
# Get these from https://app.voho.ai
#
# VOHO_API_KEY   Console → API Tokens → create a token. Starts voho_sk_live_.
#                This is a bearer credential with spending power. It is read
#                only on the server (lib/voho/client.ts carries `server-only`,
#                so importing it from a client component is a build error).
#
# VOHO_AGENT_ID  Console → Agents → open your agent → copy the ID next to the
#                agent name. The prompt, the tools and the knowledge base come
#                from this repository; the agent supplies the voice, the
#                language and the identity.
#
# VOHO_API_URL   Optional. Defaults to https://app.voho.ai/v1.

VOHO_API_KEY=voho_sk_live_replace_me
VOHO_AGENT_ID=00000000-0000-0000-0000-000000000000
# VOHO_API_URL=https://app.voho.ai/v1

# ------------------------------------------- your university's own systems
# None of these are used yet: every university-side tool in lib/tools/ is a
# mock. They are listed so it is obvious where the real credentials go, and
# so nobody puts them in the browser bundle by accident.
#
# SIS_API_URL=
# SIS_API_KEY=
# TICKETING_API_URL=
# TICKETING_API_KEY=
# SMS_PROVIDER_KEY=
